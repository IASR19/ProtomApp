# URL base da API (inclui o prefixo /api)
# iOS Simulator / Web: http://localhost:3001/api
# Android Emulator: http://10.0.2.2:3001/api
# Aparelho físico: http://SEU_IP_LOCAL:3001/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Client ID do tipo "Aplicativo da Web" (Google Cloud Console > APIs e serviços > Credenciais)
# Origens JavaScript autorizadas: http://localhost:8081 e a URL de produção do front
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
